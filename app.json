{
    "expo":  {
                 "name":  "Jeevya",
                 "slug":  "personality-improvement-app",
                 "version":  "1.1.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/icon.png",
                 "scheme":  "jeevya",
                 "userInterfaceStyle":  "automatic",
                 "ios":  {
                             "icon":  "./assets/images/icon.png",
                             "bundleIdentifier":  "com.aaditya001.personalityimprovementapp",
                             "supportsTablet":  true,
                             "buildNumber":  "2"
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#F8FAF5",
                                                      "foregroundImage":  "./assets/images/android-icon-foreground.png",
                                                      "backgroundImage":  "./assets/images/android-icon-background.png",
                                                      "monochromeImage":  "./assets/images/android-icon-monochrome.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false,
                                 "package":  "com.aaditya001.personalityimprovementapp",
                                 "allowBackup":  false,
                                 "blockedPermissions":  [
                                                            "android.permission.SYSTEM_ALERT_WINDOW",
                                                            "android.permission.READ_EXTERNAL_STORAGE",
                                                            "android.permission.WRITE_EXTERNAL_STORAGE"
                                                        ],
                                 "versionCode":  2
                             },
                 "web":  {
                             "output":  "static",
                             "favicon":  "./assets/images/favicon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "react-native-android-widget",
                                     {
                                         "widgets":  [
                                                         {
                                                             "name":  "JeevyaWidget",
                                                             "label":  "Jeevya",
                                                             "description":  "Your Jeevya life metrics at a glance.",
                                                             "minWidth":  "110dp",
                                                             "minHeight":  "70dp",
                                                             "targetCellWidth":  2,
                                                             "targetCellHeight":  2,
                                                             "maxResizeWidth":  "330dp",
                                                             "maxResizeHeight":  "330dp",
                                                             "resizeMode":  "horizontal|vertical",
                                                             "widgetFeatures":  "reconfigurable",
                                                             "updatePeriodMillis":  1800000
                                                         }
                                                     ]
                                     }
                                 ],
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#F8FAF5",
                                         "image":  "./assets/images/splash-icon.png",
                                         "imageWidth":  76
                                     }
                                 ],
                                 "expo-sharing"
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 },
                 "extra":  {
                               "router":  {

                                          },
                               "eas":  {
                                           "projectId":  "2b38de30-3dd6-4e15-b68b-16ed28f3f179"
                                       }
                           },
                 "owner":  "aaditya001"
             }
}
